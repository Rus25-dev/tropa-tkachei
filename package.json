{
  "name": "tropa-tkachei",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "description": "Тропа Ткачей v2: Phaser 4 + TypeScript + Vite. Старая игра v1.8 лежит в legacy/.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.rating.config.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "test:full": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e && npm run legacy:golden",
    "legacy:install": "npm --prefix legacy install",
    "legacy:test": "npm --prefix legacy run test:full",
    "legacy:golden": "npm --prefix legacy run golden",
    "bot": "tsx --import ./tools/ldtk-register.mjs tools/bot/cli.ts",
    "fuzz": "tsx --import ./tools/ldtk-register.mjs tools/fuzz/cli.ts",
    "replay": "tsx --import ./tools/ldtk-register.mjs tools/replay.ts",
    "sim": "tsx --import ./tools/ldtk-register.mjs tools/sim.ts",
    "boss:check": "tsx --import ./tools/ldtk-register.mjs tools/boss/check.ts",
    "boss:nohit": "tsx --import ./tools/ldtk-register.mjs tools/boss/nohit-cli.ts",
    "boss:cheese": "tsx --import ./tools/ldtk-register.mjs tools/boss/cheese.ts",
    "levels:export": "tsx tools/ldtk-export.ts",
    "levels:check": "tsx tools/levels-check.ts",
    "rl:env": "tsx --import ./tools/ldtk-register.mjs tools/rl/server.ts",
    "rl:eval": "tsx --import ./tools/ldtk-register.mjs tools/rl/agent-eval.ts",
    "rl:train": "ml/.venv-rl/Scripts/python.exe ml/rl/train.py"
  },
  "dependencies": {
    "idb-keyval": "6.3.0",
    "lil-gui": "^0.21.0",
    "peerjs": "1.5.5",
    "phaser": "4.2.1",
    "preact": "11.0.1",
    "uplot": "1.6.32",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "10.13.0",
    "peer": "^1.0.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
