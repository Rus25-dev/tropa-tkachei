								{
									"__identifier": "text",
									"__type": "Multilines",
									"__value": "Скамья: ↑ — меню: отдых (здесь ты очнёшься), лавка, карта.\nНа скамье ↓ — сразу лавка (бусины → улучшения)\nУступ: падая у края, жми к нему, ↑ — подтянуться.\nПарус (за Владика): держи прыжок в падении",
									"__tile": null,
									"defUid": 1000,
									"realEditorValues": [
										{
											"id": "V_String",
											"params": ["Скамья: ↑ — меню: отдых (здесь ты очнёшься), лавка, карта.\nНа скамье ↓ — сразу лавка (бусины → улучшения)\nУступ: падая у края, жми к нему, ↑ — подтянуться.\nПарус (за Владика): держи прыжок в падении"]
